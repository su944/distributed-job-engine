{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "postgres",
  "database.port": "5432",
  "database.user": "jobengine_cdc",
  "database.password": "${env:CDC_PASSWORD}",
  "database.dbname": "jobengine",
  "database.sslmode": "disable",
  "topic.prefix": "jobengine",
  "plugin.name": "pgoutput",
  "slot.name": "jobengine_outbox",
  "slot.drop.on.stop": "false",
  "publication.name": "jobs_outbox",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.outbox_events",
  "include.schema.changes": "false",
  "snapshot.mode": "initial",
  "heartbeat.interval.ms": "5000",
  "max.queue.size": "1024",
  "max.batch.size": "256",
  "max.queue.size.in.bytes": "8388608",
  "skipped.operations": "u,d,t",
  "tombstones.on.delete": "false",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.schemas.enable": "false",
  "transforms": "outbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "predicates": "outboxOnly",
  "predicates.outboxOnly.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.outboxOnly.pattern": "jobengine\\.public\\.outbox_events",
  "transforms.outbox.predicate": "outboxOnly",
  "transforms.outbox.table.field.event.id": "id",
  "transforms.outbox.table.field.event.payload": "payload",
  "transforms.outbox.route.topic.replacement": "jobs.ready.v1",
  "transforms.outbox.table.field.event.key": "aggregateid",
  "transforms.outbox.table.expand.json.payload": "true",
  "transforms.outbox.table.op.invalid.behavior": "fatal",
  "errors.tolerance": "none"
}
